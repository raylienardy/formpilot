*.egg-info/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
playwright-report/
test-results/
*.webm
*.har
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# PENGECUALIAN: contoh & konteks agen HARUS ter-commit
!config/example.yaml
!config/example.env
!AGENTS.md
!docs/
!tasks/
!README.md
!models/.gitkeep

